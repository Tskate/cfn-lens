{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleDetection": "force",
    "jsx": "react-jsx",

    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"],
  // Tests and their setup belong to the test program (tsconfig.test.json).
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test"]
}
