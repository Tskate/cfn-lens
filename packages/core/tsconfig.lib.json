{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo",
    // No ambient types and no DOM lib: core must run in any JS runtime (browser, worker, Lambda).
    "types": []
  },
  "include": ["src"],
  // Tests and test helpers live next to the code but belong to the test program (tsconfig.test.json).
  "exclude": ["src/**/*.test.ts", "src/fixtures"]
}
